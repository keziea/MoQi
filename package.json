{
  "name": "moqi-reader",
  "version": "0.3.0",
  "private": true,
  "description": "墨栖 · Windows 桌面中文阅读器",
  "author": "Moqi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/keziea/MoQi.git"
  },
  "homepage": "https://github.com/keziea/MoQi#readme",
  "bugs": {
    "url": "https://github.com/keziea/MoQi/issues"
  },
  "keywords": [
    "ebook",
    "reader",
    "epub",
    "mobi",
    "pdf",
    "txt",
    "electron",
    "chinese",
    "阅读器"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on tcp:5173 && npm run start:electron\"",
    "start:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder --win",
    "pack": "node scripts/pack.js"
  },
  "dependencies": {
    "chardet": "^2.1.0",
    "fast-xml-parser": "^4.5.1",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.15.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.2"
  }
}
